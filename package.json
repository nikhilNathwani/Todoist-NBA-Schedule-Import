{
	"name": "todoist-nba-schedule-import",
	"version": "1.0.0",
	"description": "An app to import NBA schedules into Todoist.",
	"type": "module",
	"main": "app.js",
	"scripts": {
		"start": "node --env-file-if-exists=.env.local server.js",
		"dev": "node --watch --env-file=.env.local server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:e2e": "playwright test"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@doist/todoist-api-typescript": "^7.10.0",
		"@hapi/iron": "^7.0.1",
		"cookie-session": "^2.1.1",
		"express": "^5.2.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@vitest/coverage-v8": "^5.0.3",
		"supertest": "^7.3.1",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": "24.x"
	}
}
